{
  "name": "pipiclaw",
  "version": "4.2.0",
  "description": "国产桌面AI自动化助手 - 基于Electron+OpenClaw",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "preview": "vite preview",
    "postinstall": "node bin/postinstall.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sandbox:build-base": "node scripts/sandbox-base-build.mjs",
    "sandbox:selfcheck": "node scripts/sandbox-selfcheck.mjs",
    "sandbox:validate": "node scripts/sandbox-validation.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:full": "npm run build && node scripts/smoke-test.mjs",
    "perf": "node scripts/perf-benchmark.mjs",
    "perf:full": "cross-env PERF_FULL=1 node scripts/perf-benchmark.mjs",
    "perf:sse": "cross-env PERF_SSE=1 node scripts/perf-benchmark.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "docs:list": "node scripts/list-docs.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@webcontainer/api": "latest",
    "docx": "^8.5.0",
    "electron-log": "^5.1.1",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.5.4",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.0",
    "pinia": "^2.1.7",
    "playwright": "^1.59.1",
    "vue": "^3.4.15",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "electron": "^30.5.1",
    "electron-builder": "^26.15.7",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.0",
    "png2icons": "^2.0.1",
    "sass": "^1.70.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.7"
  },
  "author": "PiPiClaw Team",
  "license": "MIT",
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^9.0.9"
    },
    "brace-expansion": "^2.1.2",
    "@tootallnate/once": "^2.0.1",
    "form-data": "^4.0.6",
    "immutable": "^5.1.8"
  }
}
